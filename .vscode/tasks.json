{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint:fix",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": ["$eslint-stylish"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "megalinter:fix",
      "type": "shell",
      "command": "docker run --rm -v ${workspaceFolder}:/tmp/lint -e APPLY_FIXES=all oxsecurity/megalinter:v8",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
